<Window x:Class="OverlaySpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OverlaySpike"
        Title="OverlaySpike"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized">
    <Canvas x:Name="OverlayCanvas">
        <!-- Simulated affix highlight: GA match (gold) -->
        <Border Canvas.Left="200" Canvas.Top="200"
                Width="350" Height="28"
                Background="#26FFD700"
                BorderBrush="#FFD700" BorderThickness="3,0,0,0"
                CornerRadius="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="⭐" FontSize="12" Foreground="#FFD700" Margin="0,0,6,0"/>
                <TextBlock Text="+12.5% Cooldown Reduction" FontSize="14" Foreground="#FFD700" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Simulated affix highlight: regular match (green) -->
        <Border Canvas.Left="200" Canvas.Top="232"
                Width="350" Height="28"
                Background="#264CAF50"
                BorderBrush="#4CAF50" BorderThickness="3,0,0,0"
                CornerRadius="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="✓" FontSize="12" Foreground="#4CAF50" Margin="0,0,6,0"/>
                <TextBlock Text="+1,042 Maximum Life" FontSize="14" Foreground="#4CAF50"/>
            </StackPanel>
        </Border>

        <!-- Simulated affix highlight: regular match (green) -->
        <Border Canvas.Left="200" Canvas.Top="264"
                Width="350" Height="28"
                Background="#264CAF50"
                BorderBrush="#4CAF50" BorderThickness="3,0,0,0"
                CornerRadius="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="✓" FontSize="12" Foreground="#4CAF50" Margin="0,0,6,0"/>
                <TextBlock Text="+18.7% Total Armor" FontSize="14" Foreground="#4CAF50"/>
            </StackPanel>
        </Border>

        <!-- Mini-panel -->
        <Border Canvas.Left="560" Canvas.Top="195"
                Width="200"
                Background="#D9000000"
                BorderBrush="#444444" BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel>
                <TextBlock Text="Sorcerer Ball Lightning" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Slot: Helm" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#333" CornerRadius="3" Height="6" Margin="0,0,8,0">
                        <Border Background="#4CAF50" CornerRadius="3" HorizontalAlignment="Left" Width="90"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="3/4" Foreground="#4CAF50" FontSize="12" FontWeight="Bold"/>
                </Grid>
                <TextBlock Text="⭐ 1 GA affix matched" Foreground="#FFD700" FontSize="11" Margin="0,0,0,6"/>
                <Border BorderBrush="#333" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="Missing:" Foreground="#888" FontSize="11"/>
                        <TextBlock Text="• Intelligence" Foreground="#E57373" FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Instructions (top-left) -->
        <Border Canvas.Left="20" Canvas.Top="20"
                Background="#CC000000" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="OVERLAY SPIKE TEST" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="✅ Window is transparent and click-through" Foreground="#4CAF50" FontSize="12"/>
                <TextBlock Text="✅ Try clicking through the overlay on desktop" Foreground="#4CAF50" FontSize="12"/>
                <TextBlock Text="✅ Overlay stays topmost above other windows" Foreground="#4CAF50" FontSize="12"/>
                <TextBlock Text="" FontSize="8"/>
                <TextBlock Text="Press ESC to close" Foreground="#888" FontSize="11"/>
                <TextBlock Text="Press SPACE to toggle overlay visibility" Foreground="#888" FontSize="11"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
