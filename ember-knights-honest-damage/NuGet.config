<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-local feed pin. <clear/> drops any inherited machine-global sources
    (e.g. the corporate Primo-Nexus at nexus01.s1.primo1.orch:8081, which is not
    reachable outside the office network and hard-fails restore with NU1301).
    Only the public nuget.org feed is needed here: framework reference packs
    (Microsoft.NETCore.App.Ref 6.0.x for the net6.0 plugin) come from there;
    all BepInEx/Il2CppInterop deps are local DLLs referenced by HintPath.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
