<Window x:Class="D4LootFilter.Views.BuildViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Viewer"
        Width="820" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="6"
                Padding="16,12" Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                           x:Name="BuildNameText"/>
                <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                           x:Name="BuildInfoText"/>
            </StackPanel>
        </Border>

        <!-- Two-column layout -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0" x:Name="LeftColumn"/>

                <!-- Right column -->
                <StackPanel Grid.Column="2" x:Name="RightColumn"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
